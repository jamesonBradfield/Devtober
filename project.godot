; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DevTober"
run/main_scene="uid://c7t5ep2vd50mv"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[autoload]

DebugMenu="*uid://cggqb75a8w8r"

[dotnet]

project/assembly_name="DevTober"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/sk_fly_camera/plugin.cfg")

[physics]

2d/run_on_separate_thread=true
3d/run_on_separate_thread=true
common/physics_ticks_per_second=30
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
